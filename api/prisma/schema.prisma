generator client {
  provider        = "prisma-client-js"
  //binaryTarget = "native"
  previewFeatures = ["extendedIndexes", "improvedQueryRaw"]
}

generator pothos {
  provider = "prisma-pothos-types"
}

datasource db {
  //provider = "sqlite"
  //url      = "file:./dev.db"
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Add more
enum Sex {
  MALE
  FEMALE
}

model User {
  id    String     @id @default(uuid())
  email String  @unique
  name  String?
  bio   String?
  password String?
  sex Sex?
  preferences Json?

  // all pictures of the user
  pictures  File[]

  // Votes that this user has cast
  votesCast Vote[] @relation("VotesCast")

  // Votes that this user has received
  votesReceived Vote[] @relation("VotesReceived")

  coords Unsupported("geometry(Point, 4326)")?

  @@index([coords], name: "location_idx", type: Gist)
}

model File {
  id      String     @id @default(uuid())
  path    String @unique

  user    User @relation(fields: [userId], references: [id])
  userId  String
}

model Vote {                                                                                                                                                                                                                             
  id        String      @id @default(uuid())                                                                                                                                                                                       
  voter     User     @relation("VotesCast", fields: [voterId], references: [id])
  voterId   String                                                                                                                                                                      
  votedFor     User     @relation("VotesReceived", fields: [votedForId], references: [id])       
  votedForId   String                                                                                                                                                               
  like      Boolean                                                                                                                                                                                                                      
}        
